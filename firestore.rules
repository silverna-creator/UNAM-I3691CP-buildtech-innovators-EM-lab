rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // HELPER FUNCTIONS
    // =============================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Case-insensitive role check (Admin/admin both work)
    function hasRole(role) {
      return isAuthenticated()
        && userExists()
        && getUserData().role.lower() == role.lower();
    }

    function isSameCompany(companyName) {
      return isAuthenticated()
        && userExists()
        && getUserData().company == companyName;
    }

    // =============================
    // SYSTEM STATUS
    // =============================
    match /system_status/{statusId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && hasRole("Admin");
    }

    // =============================
    // USERS
    // =============================
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (hasRole("Admin") || request.auth.uid == userId);

      allow update: if isAuthenticated() && (request.auth.uid == userId || hasRole("Admin"));

      allow delete: if isAuthenticated()
                    && hasRole("Admin")
                    && getUserData().company == resource.data.company;
    }

    // =============================
    // SUPPORT TICKETS
    // =============================
    match /support_tickets/{ticketId} {
      allow create, read: if request.auth != null;
      allow update, delete: if false;
    }

    // =============================
    // COMPANIES
    // =============================
    match /companies/{companyId} {
      allow read: if isSameCompany(companyId);
      allow create: if isAuthenticated();
      allow update, delete: if hasRole("lab_manager");
    }

    // =============================
    // INVITES
    // =============================
    match /invites/{inviteId} {
      allow create:
        if hasRole("lab_manager")
        && request.resource.data.email is string
        && request.resource.data.company is string
        && request.resource.data.role is string
        && request.resource.data.used == false;

      allow read:
        if isAuthenticated()
        && request.auth.token.email == resource.data.email
        && resource.data.used == false;

      allow update:
        if isAuthenticated()
        && request.auth.token.email == resource.data.email;

      allow delete: if false;
    }

    // =============================
    // MINERAL SAMPLES
    // =============================
    match /mineral_samples/{sampleId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (hasRole("admin") || hasRole("Admin") || hasRole("lab_manager"));
    }

    // =============================
    // TESTS
    // =============================
    match /tests/{testId} {
      allow read, update, delete: if isSameCompany(resource.data.company);
      allow create: if isSameCompany(request.resource.data.company);
    }

    // =============================
    // RESULTS
    // =============================
    match /results/{resultId} {
      allow read, update, delete: if isSameCompany(resource.data.company);
      allow create: if isSameCompany(request.resource.data.company);
    }

    // =============================
    // FURNACE OPERATIONS
    // =============================
    match /furnace_operations/{id} {
      allow read: if isAuthenticated() && (
        isSameCompany(resource.data.company)
        || isSameCompany(resource.data.companyId)
      );
      allow create: if isAuthenticated() && (
        isSameCompany(request.resource.data.company)
        || isSameCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAuthenticated() && (
        isSameCompany(resource.data.company)
        || isSameCompany(resource.data.companyId)
      );
    }

    // =============================
    // ACTIVITY LOGS
    // =============================
    match /activity_logs/{id} {
      allow read: if isSameCompany(resource.data.company);
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =============================
    // NOTIFICATIONS
    // =============================
    match /notifications/{id} {
      allow read, update, delete: if isSameCompany(resource.data.company);
      allow create: if isSameCompany(request.resource.data.company);
    }

    // =============================
    // DEFAULT DENY
    // =============================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
